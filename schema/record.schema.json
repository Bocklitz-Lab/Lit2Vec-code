{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lit2Vec Record Schema",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_id",
    "metadata",
    "abstract",
    "paragraphs",
    "embeddings",
    "tldr",
    "abstract_embedding",
    "predicted_subfield"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "corpus_id": {
      "type": ["string", "integer"]
    },
    "metadata": {
      "type": "object",
      "required": ["title", "authors", "venue", "year"],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "string"
        },
        "corpusid": {
          "type": ["string", "integer"]
        },
        "externalids": {
          "type": "object"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "authorId": {
                "type": ["string", "integer", "null"]
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "venue": {
          "type": "string"
        },
        "publicationvenueid": {
          "type": ["string", "null"]
        },
        "year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "referencecount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "citationcount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "influentialcitationcount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "isopenaccess": {
          "type": "boolean"
        },
        "publicationdate": {
          "type": ["string", "null"],
          "format": "date"
        },
        "s2fieldsofstudy": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "publicationtypes": {
          "type": ["array", "null"]
        },
        "journal": {
          "type": ["object", "null"]
        }
      }
    },
    "abstract": {
      "type": "string"
    },
    "fulltext": {
      "type": "string"
    },
    "paragraphs": {
      "type": "object",
      "patternProperties": {
        "^\\d+P\\d+$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "embeddings": {
      "type": "object",
      "patternProperties": {
        "^\\d+P\\d+$": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1024,
          "maxItems": 1024
        }
      },
      "additionalProperties": false
    },
    "abstract_embedding": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1024,
      "maxItems": 1024
    },
    "tldr": {
      "type": "string"
    },
    "predicted_subfield": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      }
    },
    "unpaywall_license": {
      "type": ["object", "null"]
    },
    "crossref_license": {
      "type": ["object", "null"]
    },
    "openalex_license": {
      "type": ["object", "null"]
    }
  }
}
